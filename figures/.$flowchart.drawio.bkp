        <mxCell id="gVmPle76FtNN2LSYm16C-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=5;fontFamily=楷体-简;align=left;strokeColor=#1E8449;strokeWidth=2;fontSize=12;fillColor=#E8F6F3;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(48, 48, 48);&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;code style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;span&gt;&lt;font face=&quot;楷体-简&quot; style=&quot;&quot;&gt;1. 初始化&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;&quot;&gt; (Initialize):&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/b&gt;&lt;/code&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span&gt;&lt;span style=&quot;color: rgb(48, 48, 48);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;生成初始空间-时间网格&amp;nbsp;&lt;/span&gt;\(\mathcal T_0\)，&lt;span style=&quot;color: rgb(48, 48, 48);&quot;&gt;布置有限元与再生核无网格节点，设定初始影响域半径&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(s_0\)。&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
