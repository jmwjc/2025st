@article{hashemi2013,
  title = {Exponential Basis Functions in Space and Time: {{A}} Meshless Method for {{2D}} Time Dependent Problems},
  shorttitle = {Exponential Basis Functions in Space and Time},
  author = {Hashemi, S. H. and Boroomand, B. and Movahedian, B.},
  year = 2013,
  month = may,
  journal = {Journal of Computational Physics},
  volume = {241},
  pages = {526--545},
  issn = {0021-9991},
  doi = {10.1016/j.jcp.2013.01.033},
  urldate = {2025-02-23},
  abstract = {In this paper we present a method based on using exponential basis functions (EBFs) to solve well-known two-dimensional time dependent engineering problems such as elasto-dynamic ones. The formulation has much in common with those in three dimensional problems while time is taken as the third axis. The solution is first approximated by a summation of EBFs and then completed by satisfying the time dependent boundary conditions as well as the initial conditions through a collocation method. This is performed by considering a series of spatial and time dependent boundary points to satisfy the boundary conditions through a mixed collocation method. The solution method is presented in a time marching form which is capable of solving variety of problems such as transient heat conduction and wave propagation in solids. Several problems are solved to demonstrate the capabilities of the method.}
}

@article{hoonhout2023,
  title = {Stable Least-Squares Space-Time Boundary Element Methods for the Wave Equation},
  author = {Hoonhout, Daniel and Loscher, Richard and Steinbach, Olaf and Urzua, Carolina},
  year = 2023,
  abstract = {In this paper, we recast the variational formulation corresponding to the single layer boundary integral operator V for the wave equation as a minimization problem in L2({$\Sigma$}), where {$\Sigma$} := {$\partial\Omega$} \texttimes{} (0, T ) is the lateral boundary of the space-time domain Q := \textohm{} \texttimes{} (0, T ). For discretization, the minimization problem is restated as a mixed saddle point formulation. Unique solvability is established by combining conforming nested boundary element spaces for the mixed formulation such that the related bilinear form is discrete inf-sup stable. We analyze under which conditions the discrete inf-sup stability is satisfied, and, moreover, we show that the mixed formulation provides a simple error indicator, which can be used for adaptivity. We present several numerical experiments showing the applicability of the method to different time-domain boundary integral formulations used in the literature.},
  langid = {english},
  file = {/Users/wujunchao/Zotero/storage/75L5GV4A/Hoonhout et al. - Stable least-squares space-time boundary element m.pdf}
}

